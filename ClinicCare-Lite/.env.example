# Copy this file to .env and fill in your values
# Never commit the real .env file to Git

# Flask secret key — change this to a random string in production
CLINICCARE_SECRET=change-this-to-something-random

# Optional: Gmail credentials for real email notifications
# Leave blank to use in-app inbox only (default)
CLINICCARE_EMAIL_ADDRESS=your-gmail@gmail.com
CLINICCARE_EMAIL_PASSWORD=your-app-password
